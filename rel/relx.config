%% Root OTP release definition used by Dockerfile and rel/build-release.sh.
%% Invoke it explicitly: ./rebar3 as prod release -c rel/relx.config
{release, {erlang_adk, "0.10.0"}, [sasl, mnesia, erlang_adk]}.
{dev_mode, false}.
{include_erts, true}.
{extended_start_script, true}.
{generate_start_script, true}.
{sys_config, "rel/sys.config"}.
{vm_args, "rel/vm.args"}.
{overlay, [
    {mkdir, "data"},
    {mkdir, "log"},
    {mkdir, "etc"},
    {copy, "scripts/deployment/container-entrypoint.sh",
           "bin/container-entrypoint"},
    {copy, "scripts/deployment/release-health.sh",
           "bin/deployment-health"},
    {copy, "rel/health-http.sys.config.src",
           "etc/health-http.sys.config.src"}
]}.
