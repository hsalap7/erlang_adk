{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["replicaCount", "topology", "image"],
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1, "maximum": 64},
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["singleReplicaOnly"],
      "properties": {"singleReplicaOnly": {"type": "boolean"}}
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/:+-]*$"},
        "digest": {"type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {"type": "array", "items": {"type": "object"}},
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "serviceAccount": {"type": "object"},
    "podAnnotations": {"type": "object"},
    "podLabels": {"type": "object"},
    "podSecurityContext": {"type": "object"},
    "securityContext": {"type": "object"},
    "strategy": {"type": "object"},
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 10, "maximum": 600},
    "resources": {"type": "object"},
    "service": {"type": "object"},
    "ingress": {"type": "object"},
    "runtimeConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingConfigMap"],
      "properties": {"existingConfigMap": {"type": "string", "maxLength": 253}}
    },
    "credentials": {"type": "object"},
    "readinessHook": {"type": "object"},
    "storage": {"type": "object"},
    "probes": {"type": "object"},
    "otlp": {"type": "object"},
    "networkPolicy": {"type": "object"},
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"}
  }
}
